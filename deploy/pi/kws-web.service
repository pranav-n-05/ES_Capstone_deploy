[Unit]
Description=Marvin keyword spotting web UI
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__DIR__/.venv/bin/python app.py --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
